# Copy to your deployment environment (do not commit real values).
# All of these are REQUIRED in production (DJANGO_DEBUG=False).

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=            # generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Real WhatsApp number for manual payment flow (international format, no '+').
WHATSAPP_NUMBER=2348000000000

# Password reset email delivery. Environment variables must be loaded by your host.
# Local DEBUG mode prints reset emails to the development server console.
# Use SMTP to deliver to real inboxes; choose TLS (587) OR SSL (465).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Egalitarian Computers <contactegalitarian@gmail.com>
